#!/bin/sh

APP_DIR="/Applications/ChargeLimiter.app"
DAEMON_PLIST="/Library/LaunchDaemons/com.chargelimiter.mod.plist"

"$APP_DIR/ChargeLimiterDaemon" reset 2>/dev/null
launchctl bootout system "$DAEMON_PLIST" 2>/dev/null || launchctl unload "$DAEMON_PLIST" 2>/dev/null
killall -9 ChargeLimiter ChargeLimiterDaemon 2>/dev/null
uicache -p "$APP_DIR" 2>/dev/null

exit 0
