#!/bin/sh

APP_DIR="/Applications/ChargeLimiter.app"
DAEMON_PLIST="/Library/LaunchDaemons/com.chargelimiter.mod.plist"
CACHE="/var/mobile/Library/Preferences/com.chargelimiter.mod.containerpath"

# 修复共享配置数据目录权限：daemon 以 root 运行时会以 root:wheel 创建文件，
# 导致 mobile App 无法以原子替换方式写入 com.chargelimiter.mod.plist。
# 原生 roothide 安装时 maintainer 脚本已在 jbroot 命名空间内，
# /var/mobile/ChargeLimiter 按 jbroot 逻辑路径书写即可（不要写成 /rootfs/...）。
DATA_DIR="/var/mobile/ChargeLimiter"

fail_install() {
    echo "ChargeLimiter postinst: $*" >&2
    exit 1
}

repair_shared_data_permissions() {
    if [ -d "$DATA_DIR" ]; then
        chown mobile:mobile "$DATA_DIR"
        chmod 0750 "$DATA_DIR"
    fi
    for conf_path in "$DATA_DIR"/com.chargelimiter.mod.plist; do
        if [ -e "$conf_path" ]; then
            chown mobile:mobile "$conf_path"
            chmod 0640 "$conf_path"
        fi
    done
}

chown -R root:wheel "$APP_DIR"
chmod +s "$APP_DIR/ChargeLimiterDaemon"
killall -9 ChargeLimiter ChargeLimiterDaemon 2>/dev/null
rm -f "$CACHE"

# 在 daemon bootstrap 前修复共享数据目录权限，避免 daemon 重新夺走所有权。
repair_shared_data_permissions

chown root:wheel "$DAEMON_PLIST"

# relaxin: system 域 launchd 在 rootfs 命名空间，看不到 jbroot 内的逻辑路径。
# 用 jbroot 命令把 Program 解析成 /rootfs/.jbroot-XXX/... 真实路径，
# 否则 bootstrap 成功但 daemon 永不 exec。
DAEMON_BIN="$APP_DIR/ChargeLimiterDaemon"
REAL_DAEMON=""
command -v jbroot >/dev/null 2>&1 || fail_install "jbroot command is unavailable"
REAL_DAEMON="$(jbroot "$DAEMON_BIN" 2>/dev/null)" || \
    fail_install "jbroot failed to resolve $DAEMON_BIN"

case "$REAL_DAEMON" in
    */.jbroot-*/Applications/ChargeLimiter.app/ChargeLimiterDaemon) ;;
    *) fail_install "invalid daemon path resolved by jbroot: ${REAL_DAEMON:-<empty>}" ;;
esac
[ -x "$REAL_DAEMON" ] || fail_install "resolved daemon is not executable: $REAL_DAEMON"

# 不同安装器下 postinst 的路径语义不同：有的运行在 jbroot 命名空间内
# （/ 即 jbroot 根，真实 rootfs 挂在 /rootfs，系统二进制不在 /usr/bin），
# 有的直接运行在真实 rootfs 上。plutil 因此不能假定在 PATH 里，
# 按三种来源依次探测；plist 同样解析成系统工具必然可见的真实路径。
# 提示：真实 rootfs 前缀从 jbroot 已解析出的 REAL_DAEMON 推导，不硬编码。
ROOTFS_PREFIX="${REAL_DAEMON%%/.jbroot-*}"
PLUTIL_BIN="$(command -v plutil 2>/dev/null || true)"
if [ -z "$PLUTIL_BIN" ]; then
    for cand in \
        "$(jbroot /usr/bin/plutil 2>/dev/null)" \
        "$ROOTFS_PREFIX/usr/bin/plutil"; do
        if [ -n "$cand" ] && [ -x "$cand" ]; then
            PLUTIL_BIN="$cand"
            break
        fi
    done
fi
[ -n "$PLUTIL_BIN" ] && [ -x "$PLUTIL_BIN" ] || \
    fail_install "plutil not found (tried PATH, jbroot /usr/bin/plutil, $ROOTFS_PREFIX/usr/bin/plutil)"

REAL_PLIST="$(jbroot "$DAEMON_PLIST" 2>/dev/null)" || \
    fail_install "jbroot failed to resolve $DAEMON_PLIST"
[ -f "$REAL_PLIST" ] || fail_install "daemon plist not found: ${REAL_PLIST:-<empty>}"

"$PLUTIL_BIN" -replace Program -string "$REAL_DAEMON" "$REAL_PLIST" || \
    fail_install "failed to update Program in daemon plist (plutil=$PLUTIL_BIN plist=$REAL_PLIST)"
"$PLUTIL_BIN" -replace ProgramArguments.0 -string "$REAL_DAEMON" "$REAL_PLIST" || \
    fail_install "failed to update ProgramArguments in daemon plist (plutil=$PLUTIL_BIN)"

# launchctl 同理按三来源解析；plist 参数保持 jbroot 逻辑路径
# （launchctl 客户端侧读取 plist，真机 relaxin 轮3已验证此路径可用）。
LAUNCHCTL_BIN="$(command -v launchctl 2>/dev/null || true)"
if [ -z "$LAUNCHCTL_BIN" ]; then
    for cand in \
        "$(jbroot /usr/bin/launchctl 2>/dev/null)" \
        "$ROOTFS_PREFIX/usr/bin/launchctl" \
        "$ROOTFS_PREFIX/bin/launchctl"; do
        if [ -n "$cand" ] && [ -x "$cand" ]; then
            LAUNCHCTL_BIN="$cand"
            break
        fi
    done
fi
[ -n "$LAUNCHCTL_BIN" ] && [ -x "$LAUNCHCTL_BIN" ] || \
    fail_install "launchctl not found (tried PATH, jbroot /usr/bin/launchctl, $ROOTFS_PREFIX/usr/bin/launchctl)"

# 清理新旧域的可能残留
"$LAUNCHCTL_BIN" bootout system "$DAEMON_PLIST" 2>/dev/null
"$LAUNCHCTL_BIN" bootout user/foreground "$DAEMON_PLIST" 2>/dev/null
if ! "$LAUNCHCTL_BIN" bootstrap system "$DAEMON_PLIST" 2>/dev/null; then
    "$LAUNCHCTL_BIN" load "$DAEMON_PLIST" 2>/dev/null || \
        fail_install "launchctl failed to load daemon plist (launchctl=$LAUNCHCTL_BIN)"
fi

uicache -p "$APP_DIR" 2>/dev/null

exit 0
